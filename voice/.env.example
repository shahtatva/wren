# Copy to .env. Server-side only: these keys never reach the browser.

# Speech-to-text (Nova-3) and text-to-speech (Aura-2)
DEEPGRAM_API_KEY=
# Conversation LLM
GROQ_API_KEY=
# Background LLM (extraction, compaction) and embeddings
GEMINI_API_KEY=

# Supabase (Postgres + pgvector)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Comma-separated origins allowed to open the voice WebSocket
ALLOWED_ORIGINS=http://localhost:3000
