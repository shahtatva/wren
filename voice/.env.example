# Copy to .env. Server-side only: these keys never reach the browser.

# Speech-to-text (Nova-3) and text-to-speech (Aura-2)
DEEPGRAM_API_KEY=
# Conversation LLM, and query rewriting before retrieval
GROQ_API_KEY=
# Background LLM (extraction, compaction) and embeddings
GEMINI_API_KEY=

# Model IDs. Pin exact IDs, never -latest aliases, so eval runs stay comparable.
# Extraction stays on Flash: with Flash Lite, E1 let 3 of 9 changed facts go stale (evals/results.csv).
GEMINI_FLASH_MODEL=gemini-3.8-flash
# Changing the embedding model means re-embedding every memory: the vector spaces don't match.
GEMINI_EMBED_MODEL=gemini-embedding-2
GROQ_REWRITE_MODEL=openai/gpt-oss-20b
# Wren's conversation model. A different model from the rewrite, so the two calls
# don't share one model's free-tier token limit. Not qwen/qwen3.8-27b: it often ended
# replies after a word or two, or sent nothing (2026-10-23 replays: 0 of 4 finished).
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# Used when the chat model is rate-limited. Groq limits are per model. This is also the
# rewrite model, so the two share a limit, but only while the chat model is rate-limited.
GROQ_CHAT_FALLBACK_MODEL=openai/gpt-oss-20b
# The chat's last resort after both Groq models, tried in order. Flash Lite allows 15
# requests a minute and 500 a day. Flash allows 5 and 20, and extraction needs those.
# Empty: GEMINI_FLASH_MODEL.
GEMINI_CHAT_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
DEEPGRAM_STT_MODEL=nova-3
# Wren's voice. Audition others with: python -m app.tools.voices
DEEPGRAM_TTS_MODEL=aura-2-vesta-en

# Supabase (Postgres + pgvector, and Auth for sign-in)
# The project URL, https://<ref>.supabase.co. The REST URL (.../rest/v1/) works too: Auth calls use the host.
SUPABASE_URL=
# A secret key (sb_secret_...). Server-side only: it reaches Supabase in the apikey header, never the browser.
SUPABASE_SECRET_KEY=
# Session pooler connection string (Connect > Session pooler), password percent-encoded,
# with ?sslmode=require on the end so the driver never falls back to plaintext
DATABASE_URL=

# Comma-separated origins allowed to open the voice WebSocket
ALLOWED_ORIGINS=http://localhost:3000

# Local development only: the auth.users id that connections from this machine act as,
# until real sign-in exists. Accepted only from loopback addresses. Leave it unset on
# any deployed server.
WREN_DEV_USER_ID=
