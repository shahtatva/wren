# Copy to .env. Server-side only: these keys never reach the browser.

# Speech-to-text (Nova-3) and text-to-speech (Aura-2)
DEEPGRAM_API_KEY=
# Conversation LLM, and query rewriting before retrieval
GROQ_API_KEY=
# Background LLM (extraction, compaction) and embeddings
GEMINI_API_KEY=

# Model IDs. Pin exact IDs, never -latest aliases, so eval runs stay comparable.
GEMINI_FLASH_MODEL=gemini-3.8-flash
# Changing the embedding model means re-embedding every memory: the vector spaces don't match.
GEMINI_EMBED_MODEL=gemini-embedding-2
GROQ_REWRITE_MODEL=openai/gpt-oss-20b

# Supabase (Postgres + pgvector)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Session pooler connection string (Connect > Session pooler), password percent-encoded,
# with ?sslmode=require on the end so the driver never falls back to plaintext
DATABASE_URL=

# Comma-separated origins allowed to open the voice WebSocket
ALLOWED_ORIGINS=http://localhost:3000
